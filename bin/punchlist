#!/usr/bin/env node
// punchlist — thin CLI over the repo. Plain node, no dependencies.
//   punchlist serve                                start the server (node src/server.js)
//   punchlist mcp                                  run the MCP stdio server (src/mcp.js)
//   punchlist install -t claude|hermes|all [--print-config]
//                                                  register the MCP server with an agent
//   punchlist install-service [--print] [--no-start]
//                                                  install the always-on service:
//                                                  systemd (Linux) or launchd (macOS)
//   punchlist install-silverbullet [--print] [--no-start] [--version TAG] [--skip-binary]
//                                                  provision the pinned SilverBullet binary
//                                                  and install the OPTIONAL SilverBullet
//                                                  KB service (data/kb, loopback only)
//   punchlist expose-kb [--off] [--status] [--print]
//                                                  wire/inspect the tailnet edge for the
//                                                  SilverBullet KB via `tailscale serve`
//   punchlist gen-token <actor>                    print a ready-to-paste token pair
//   punchlist install-skills [--claude DIR] [--hermes DIR]
//                                                  copy the agent skills into place
//   punchlist snapshot                             WAL-safe db backup (scripts/db-snapshot.sh)
import { spawn, spawnSync } from 'node:child_process';
import { cpSync, copyFileSync, existsSync, mkdirSync, writeFileSync, chmodSync, statSync, readdirSync, unlinkSync } from 'node:fs';
import { join, dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { homedir, tmpdir } from 'node:os';
import { randomBytes } from 'node:crypto';
import { DatabaseSync } from 'node:sqlite';
import {
  serviceSpec, silverbulletSpec, silverbulletDownloadSpec, silverbulletBinDir, silverbulletBinPath,
  SILVERBULLET_VERSION,
} from '../src/service.js';
import { tailscaleServeSpec } from '../src/tailscale.js';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');

function run(cmd, args) {
  const child = spawn(cmd, args, { stdio: 'inherit' });
  child.on('exit', (code, signal) => process.exit(signal ? 1 : code ?? 1));
  child.on('error', err => { console.error(`punchlist: ${err.message}`); process.exit(1); });
}

function parseFlags(argv, allowed) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const name = argv[i].replace(/^--/, '');
    if (!argv[i].startsWith('--') || !allowed.includes(name) || argv[i + 1] === undefined) {
      console.error(`punchlist: bad flag ${argv[i]} (allowed: ${allowed.map(a => '--' + a).join(', ')})`);
      process.exit(2);
    }
    flags[name] = argv[++i];
  }
  return flags;
}

// Copy one skill dir and make it self-contained: the canonical shared pl.sh
// lands next to the shim as scripts/pl-core.sh, and scripts/pl.sh becomes a
// tiny wrapper that pins the agent's own token file (PUNCHLIST_ENV_FILE) so
// each agent authenticates as ITSELF on multi-agent machines.
function installSkill(srcDir, destDir, envFileExpr) {
  mkdirSync(destDir, { recursive: true });
  cpSync(srcDir, destDir, { recursive: true });
  mkdirSync(join(destDir, 'scripts'), { recursive: true }); // some skills ship no scripts/ dir
  const core = join(destDir, 'scripts', 'pl-core.sh');
  copyFileSync(join(ROOT, 'skills', 'shared', 'pl.sh'), core);
  chmodSync(core, 0o755);
  const shim = join(destDir, 'scripts', 'pl.sh');
  writeFileSync(shim, '#!/usr/bin/env bash\n' +
    `exec env PUNCHLIST_ENV_FILE="${envFileExpr}" "$(dirname "\${BASH_SOURCE[0]}")/pl-core.sh" "$@"\n`);
  chmodSync(shim, 0o755);
  // the screening library (agent-security layer 2) travels with every skill;
  // it needs no token, so the canonical copy lands as-is (replacing the
  // repo-relative shim from the source dir)
  const screen = join(destDir, 'scripts', 'screen.sh');
  copyFileSync(join(ROOT, 'skills', 'shared', 'screen.sh'), screen);
  chmodSync(screen, 0o755);
  // the data-governance guard + PreToolUse wrapper travel with every skill too
  // (no token needed) so `govern.sh classify` / the hook are always reachable
  for (const g of ['govern.sh', 'govern-hook.sh']) {
    const dst = join(destDir, 'scripts', g);
    copyFileSync(join(ROOT, 'skills', 'shared', g), dst);
    chmodSync(dst, 0o755);
  }
  console.log(`installed ${destDir}`);
}

// ---- MCP registration (codegraph-style): register where we safely can,
// print copy-paste config where we must not edit files we don't own. ----
const CLAUDE_SNIPPET = `{
  "mcpServers": {
    "punchlist": {
      "command": "punchlist",
      "args": ["mcp"]
    }
  }
}`;
const HERMES_SNIPPET = `mcp_servers:
  punchlist:
    command: punchlist
    args: [mcp]`;
const ENV_NOTE = `
The MCP server authenticates like the skills do: PUNCHLIST_TOKEN in the agent's
environment, or PUNCHLIST_ENV_FILE, or ~/.claude/secrets.local.env, or
$HERMES_HOME/.env. Non-default server? Also set PUNCHLIST_URL (default
http://127.0.0.1:8600). \`punchlist\` must be on PATH (npm link / npm i -g).`;

function installClaude({ printOnly }) {
  if (!printOnly && spawnSync('claude', ['--version'], { stdio: 'ignore' }).status === 0) {
    const r = spawnSync('claude', ['mcp', 'add', 'punchlist', '--scope', 'user', '--', 'punchlist', 'mcp'],
      { stdio: 'inherit' });
    if (r.status === 0) { console.log('registered with Claude Code (user scope)'); return; }
    console.error('claude mcp add failed — falling back to the config snippet:');
  } else if (!printOnly) {
    console.log('claude CLI not found — add this to your project .mcp.json (or Claude Desktop config):');
  } else {
    console.log('Claude Code: `claude mcp add punchlist --scope user -- punchlist mcp`, or .mcp.json:');
  }
  console.log(CLAUDE_SNIPPET);
}

function installHermes() {
  console.log('Hermes: add to the mcp_servers block of $HERMES_HOME/config.yaml (not edited automatically):');
  console.log(HERMES_SNIPPET);
}

function installMcp(argv) {
  let target = null, printOnly = false;
  for (let i = 0; i < argv.length; i++) {
    if ((argv[i] === '-t' || argv[i] === '--target') && argv[i + 1]) target = argv[++i];
    else if (argv[i] === '--print-config') printOnly = true;
    else { console.error(`punchlist: bad flag ${argv[i]}`); process.exit(2); }
  }
  if (printOnly && !target) target = 'all';
  if (!['claude', 'hermes', 'all'].includes(target)) {
    console.error('usage: punchlist install -t claude|hermes|all [--print-config]');
    process.exit(2);
  }
  if (target === 'claude' || target === 'all') installClaude({ printOnly });
  if (target === 'all') console.log('');
  if (target === 'hermes' || target === 'all') installHermes();
  console.log(ENV_NOTE);
}

// ---- service install (systemd on Linux, launchd on macOS) ----
// One command, both OSes: `punchlist install-service`. Platform-specific unit
// rendering lives in src/service.js; this does the file write + service load.
async function healthCheck(port, tries = 20) {
  for (let i = 0; i < tries; i++) {
    try { if ((await fetch(`http://127.0.0.1:${port}/api/v1/health`)).ok) return true; } catch { /* not up yet */ }
    await new Promise(r => setTimeout(r, 600));
  }
  return false;
}

async function installService(argv) {
  let printOnly = false, noStart = false, platform = process.platform;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--print') printOnly = true;
    else if (argv[i] === '--no-start') noStart = true;
    else if (argv[i] === '--platform' && argv[i + 1]) platform = argv[++i]; // for --print / testing
    else { console.error(`punchlist: bad flag ${argv[i]} (allowed: --print, --no-start, --platform)`); process.exit(2); }
  }
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const spec = serviceSpec(platform, { repo: ROOT, dataDir, node: process.execPath, home: homedir() });

  if (printOnly) { console.log(`# ${spec.kind} unit -> ${spec.path}\n`); process.stdout.write(spec.contents); return; }
  if (platform !== process.platform) {
    console.error(`punchlist: refusing to install a ${platform} service on ${process.platform} (drop --platform, or use --print)`);
    process.exit(2);
  }
  const envFile = join(dataDir, '.env');
  if (!existsSync(envFile)) {
    console.error(`punchlist: missing ${envFile} (it holds PUNCHLIST_TOKENS). Generate a token first:\n` +
      `  punchlist gen-token <actor>   # e.g. aron\n` +
      `then create ${envFile} (chmod 600) with the PUNCHLIST_TOKENS line it prints.`);
    process.exit(1);
  }

  mkdirSync(dirname(spec.path), { recursive: true });
  writeFileSync(spec.path, spec.contents);
  if (spec.mode) chmodSync(spec.path, spec.mode);
  console.log(`wrote ${spec.kind} unit -> ${spec.path}`);
  if (noStart) { console.log(`(--no-start) not loading it. Start later with: ${spec.start[0][0]} ${spec.start[0][1].join(' ')}`); return; }

  // reload/unload is best-effort (fails harmlessly on a first install)
  for (const [c, a] of spec.reload) spawnSync(c, a, { stdio: 'ignore' });
  for (const [c, a] of spec.start) spawnSync(c, a, { stdio: 'inherit' });

  if (await healthCheck(spec.port)) {
    console.log(`punchlist: healthy on http://127.0.0.1:${spec.port} — service is running`);
  } else {
    console.error(`punchlist: unit written but health check failed. Inspect: ${spec.status[0]} ${spec.status[1].join(' ')}`);
    process.exitCode = 1;
  }
}

// ---- SilverBullet service install (optional, second service) ----
// Mirrors installService() above but for the SilverBullet KB editor: writes
// a secret-free unit/plist plus a wrapper script that sources the SB auth
// password from envFile (mode 600) at run time. Space root is
// <dataDir>/kb — never the whole dataDir. Does NOT install Deno/SilverBullet
// and does NOT start anything unless --no-start is absent and the OS matches.
// Resolve which SB binary the wrapper should exec, in precedence order:
//   1. SILVERBULLET_CMD env — user override, no download, used as-is.
//   2. The managed pinned path (already installed) — idempotent, no re-download.
//   3. The managed pinned path, not yet installed — caller must provision it
//      first (see provisionSilverbullet below) unless --skip-binary.
// Pure decision logic; no I/O beyond the existsSync presence check.
function resolveSilverbulletCmd(home, version) {
  if (process.env.SILVERBULLET_CMD) return { cmd: process.env.SILVERBULLET_CMD, source: 'env', needsInstall: false };
  const pinned = silverbulletBinPath(home, version);
  return { cmd: pinned, source: 'pinned', needsInstall: !existsSync(pinned) };
}

// Actually download + unzip the pinned SilverBullet release into the managed
// bin dir. Only called from the live (non-print, non-skip) path — never from
// --print or doctor. Fails loudly (exit 2) rather than leaving a half-baked
// install; cleans up its temp zip either way.
function provisionSilverbullet(home, version) {
  const dlSpec = silverbulletDownloadSpec(process.platform, process.arch, version);
  const missing = ['curl', 'unzip'].filter(c => spawnSync(c, [c === 'curl' ? '--version' : '-v'], { stdio: 'ignore' }).status !== 0);
  if (missing.length) {
    console.error(`punchlist: missing required tool(s): ${missing.join(', ')}. Install them, or set ` +
      `SILVERBULLET_CMD=/path/to/silverbullet to point at an existing binary instead.`);
    process.exit(2);
  }
  const binDir = silverbulletBinDir(home, version);
  const binPath = silverbulletBinPath(home, version);
  mkdirSync(binDir, { recursive: true });
  const tmpZip = join(tmpdir(), `silverbullet-${version}-${process.pid}.zip`);
  console.log(`downloading ${dlSpec.url} ...`);
  const dl = spawnSync('curl', ['-fsSL', '--proto', '=https', '--tlsv1.2', '-o', tmpZip, dlSpec.url], { stdio: 'inherit' });
  if (dl.status !== 0) {
    try { unlinkSync(tmpZip); } catch { /* nothing to clean up */ }
    console.error(`punchlist: download failed (curl exited ${dl.status}). No unit was written.`);
    process.exit(2);
  }
  console.log(`unzipping -> ${binDir}`);
  const uz = spawnSync('unzip', ['-o', tmpZip, '-d', binDir], { stdio: 'inherit' });
  try { unlinkSync(tmpZip); } catch { /* best-effort cleanup */ }
  if (uz.status !== 0) {
    console.error(`punchlist: unzip failed (exited ${uz.status}). No unit was written.`);
    process.exit(2);
  }
  if (!existsSync(binPath)) {
    console.error(`punchlist: expected binary not found after unzip: ${binPath} (the release asset's internal ` +
      `filename may differ from the assumed "silverbullet" — inspect ${binDir} and set SILVERBULLET_CMD as a workaround).`);
    process.exit(2);
  }
  chmodSync(binPath, 0o755);
  console.log(`provisioned SilverBullet ${version} -> ${binPath}`);
}

async function installSilverbullet(argv) {
  let printOnly = false, noStart = false, skipBinary = false, platform = process.platform;
  let version = process.env.PUNCHLIST_SB_VERSION || SILVERBULLET_VERSION;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--print') printOnly = true;
    else if (argv[i] === '--no-start') noStart = true;
    else if (argv[i] === '--skip-binary') skipBinary = true;
    else if (argv[i] === '--platform' && argv[i + 1]) platform = argv[++i]; // for --print / testing
    else if (argv[i] === '--version' && argv[i + 1]) version = argv[++i];
    else { console.error(`punchlist: bad flag ${argv[i]} (allowed: --print, --no-start, --platform, --version, --skip-binary)`); process.exit(2); }
  }
  const home = homedir();
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const spaceDir = join(dataDir, 'kb');
  const resolved = resolveSilverbulletCmd(home, version);
  const spec = silverbulletSpec(platform, { repo: ROOT, spaceDir, home, cmd: resolved.cmd });

  if (printOnly) {
    console.log(`# binary source: ${resolved.source}${resolved.needsInstall ? ' (not yet installed)' : ''} -> ${resolved.cmd}`);
    if (resolved.source === 'pinned') {
      try {
        const dlSpec = silverbulletDownloadSpec(platform, process.arch, version);
        console.log(`# download (NOT executed by --print): ${dlSpec.url}`);
        console.log(`# target: ${silverbulletBinPath(home, version)}`);
      } catch (err) {
        console.log(`# download spec unavailable: ${err.message}`);
      }
    }
    console.log(`\n# wrapper -> ${spec.wrapperPath}\n`);
    process.stdout.write(spec.wrapperContents);
    console.log(`\n# ${spec.kind} unit -> ${spec.path}\n`);
    process.stdout.write(spec.contents);
    console.log(`\n# reload: ${spec.reload.map(([c, a]) => `${c} ${a.join(' ')}`).join(' && ')}`);
    console.log(`# start:  ${spec.start.map(([c, a]) => `${c} ${a.join(' ')}`).join(' && ')}`);
    return;
  }
  if (platform !== process.platform) {
    console.error(`punchlist: refusing to install a ${platform} service on ${process.platform} (drop --platform, or use --print)`);
    process.exit(2);
  }

  if (resolved.needsInstall && !skipBinary) {
    provisionSilverbullet(home, version);
  } else if (resolved.needsInstall && skipBinary) {
    console.log(`(--skip-binary) not provisioning ${resolved.cmd} — install it yourself before starting the service.`);
  } else if (resolved.source === 'pinned') {
    console.log(`SB binary already provisioned -> ${resolved.cmd}`);
  } else {
    console.log(`SB binary from SILVERBULLET_CMD -> ${resolved.cmd}`);
  }

  mkdirSync(spaceDir, { recursive: true });

  // Seed a starter index page so a fresh space isn't an empty screen. Only when
  // the space is genuinely empty — never overwrite existing notes.
  if (readdirSync(spaceDir).length === 0) {
    writeFileSync(join(spaceDir, 'index.md'),
      `# Knowledge base\n\n` +
      `This is the SilverBullet space for this punchlist instance. It lives in ` +
      `\`data/kb\` (the private plane) and is served read-write here, read-only in ` +
      `the app's Instance dialog.\n\n` +
      `Create a page with \`[[Some Page]]\` and click it. Everything you write ` +
      `stays on this machine and is covered by the instance backup.\n`);
    console.log(`seeded starter -> ${join(spaceDir, 'index.md')}`);
  }

  if (!existsSync(spec.envFile)) {
    mkdirSync(dirname(spec.envFile), { recursive: true });
    writeFileSync(spec.envFile, 'SB_USER=admin:CHANGME\n');
    chmodSync(spec.envFile, 0o600);
    console.log(`wrote ${spec.envFile} (mode 600) — EDIT THIS before starting: set SB_USER=user:pass`);
  } else {
    console.log(`envFile already present, left untouched: ${spec.envFile}`);
  }

  mkdirSync(dirname(spec.wrapperPath), { recursive: true });
  writeFileSync(spec.wrapperPath, spec.wrapperContents);
  chmodSync(spec.wrapperPath, spec.wrapperMode);
  console.log(`wrote wrapper -> ${spec.wrapperPath}`);

  mkdirSync(dirname(spec.path), { recursive: true });
  writeFileSync(spec.path, spec.contents);
  if (spec.mode) chmodSync(spec.path, spec.mode);
  console.log(`wrote ${spec.kind} unit -> ${spec.path}`);
  console.log(`note: SB opens a new loopback listener on ${spec.host}:${spec.port}. If this host runs a port-baseline security monitor, accept the new port in its baseline (its --bless / re-seed step) so it isn't flagged as an unknown listener.`);

  if (noStart) { console.log(`(--no-start) not loading it. Start later with: ${spec.start[0][0]} ${spec.start[0][1].join(' ')}`); return; }

  // reload/unload is best-effort (fails harmlessly on a first install)
  for (const [c, a] of spec.reload) spawnSync(c, a, { stdio: 'ignore' });
  for (const [c, a] of spec.start) spawnSync(c, a, { stdio: 'inherit' });
  console.log(`punchlist: SilverBullet unit started (bound to ${spec.host}:${spec.port}, loopback only) — check ${spec.status[0]} ${spec.status[1].join(' ')}`);
}

// ---- expose-kb: wire the tailnet edge for the SilverBullet KB ----
// `tailscale serve` fronts the loopback-bound SB service with tailnet
// identity + automatic HTTPS (see docs/2026-08-31-kb-silverbullet.md,
// "Exposure model"). This command never touches SB itself — it only renders
// and (optionally) runs `tailscale serve` commands. The port is derived from
// silverbulletSpec() so it can never drift out of sync with the service that
// install-silverbullet actually wires up.
function exposeKbSpec(platform = process.platform) {
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const sb = silverbulletSpec(platform, { repo: ROOT, spaceDir: join(dataDir, 'kb'), home: homedir() });
  return tailscaleServeSpec({ port: sb.port });
}

function printExposeKb(spec) {
  console.log('# enable (background, persistent):');
  console.log(`${spec.on[0]} ${spec.on[1].join(' ')}`);
  console.log('\n# status:');
  console.log(`${spec.status[0]} ${spec.status[1].join(' ')}`);
  console.log('\n# disable:');
  console.log(`${spec.off[0]} ${spec.off[1].join(' ')}`);
  console.log(`\n# resulting URL: https://<magicdns-name>/  (this machine's Tailscale MagicDNS name)`);
  console.log('# prerequisites: MagicDNS + HTTPS certs enabled on the tailnet;');
  console.log('# on Linux a non-root user needs `tailscale set --operator=$USER` (or sudo) to run serve.');
}

function expose(argv) {
  let printOnly = false, off = false, status = false;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--print') printOnly = true;
    else if (argv[i] === '--off') off = true;
    else if (argv[i] === '--status') status = true;
    else { console.error(`punchlist: bad flag ${argv[i]} (allowed: --off, --status, --print)`); process.exit(2); }
  }
  if (off && status) { console.error('punchlist: --off and --status are mutually exclusive'); process.exit(2); }

  const spec = exposeKbSpec();

  if (printOnly) { printExposeKb(spec); return; }

  // cheap precondition: is `tailscale` even on PATH?
  const found = spawnSync('tailscale', ['version'], { stdio: 'ignore' });
  if (found.error || found.status !== 0) {
    console.error('punchlist: `tailscale` not found on PATH. Install Tailscale first: https://tailscale.com/download');
    process.exit(2);
  }

  if (status) { spawnSync(spec.status[0], spec.status[1], { stdio: 'inherit' }); return; }
  if (off) {
    spawnSync(spec.off[0], spec.off[1], { stdio: 'inherit' });
    console.log('punchlist: tailscale serve disabled for the KB target.');
    return;
  }

  spawnSync(spec.on[0], spec.on[1], { stdio: 'inherit' });
  console.log(`\npunchlist: tailscale serve enabled -> ${spec.target} (https=${spec.httpsPort})`);
  console.log('Check `tailscale serve status` to confirm, and visit https://<magicdns-name>/.');
  console.log('Prerequisites: MagicDNS + HTTPS certs enabled on the tailnet; on Linux you may need');
  console.log('`tailscale set --operator=$USER` (or sudo) for this command to work.');
}

// ---- token generation: print a ready-to-paste PUNCHLIST_TOKENS pair ----
// Never writes your env files (same policy as install-skills); prints only.
function genToken(argv) {
  const actor = argv[0];
  if (!actor || actor.startsWith('-')) {
    console.error('usage: punchlist gen-token <actor>   # e.g. aron, claude, hermes');
    process.exit(2);
  }
  const token = randomBytes(24).toString('hex'); // 48 hex chars (server floor is 32)
  console.log(`# Server side — add "${actor}" to PUNCHLIST_TOKENS in your data/.env (chmod 600).`);
  console.log(`# The FIRST actor is the admin unless PUNCHLIST_ADMIN is set.`);
  console.log(`PUNCHLIST_TOKENS=${actor}:${token}`);
  console.log(`# Client side — give that actor its token (e.g. ~/.claude/secrets.local.env, chmod 600):`);
  console.log(`PUNCHLIST_TOKEN=${token}`);
}

// ---- doctor: prerequisites + config + service + health, one checklist ----
// Cross-platform: uses the same serviceSpec() to know where the unit lives, and
// /health for liveness. Never reads token *values* — only stats data/.env.
async function doctor() {
  const platform = process.platform;
  const home = homedir();
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const port = 8600;
  let hardFail = false;
  const ok = (l, x = '') => console.log(`  ✓ ${l}${x ? `  — ${x}` : ''}`);
  const bad = (l, x = '') => { console.log(`  ✗ ${l}${x ? `  — ${x}` : ''}`); hardFail = true; };
  const warn = (l, x = '') => console.log(`  ⚠ ${l}${x ? `  — ${x}` : ''}`);
  const onPath = c => spawnSync('sh', ['-c', `command -v ${c}`], { stdio: 'ignore' }).status === 0;

  console.log('punchlist doctor\n\nPrerequisites:');
  const nmaj = Number(process.versions.node.split('.')[0]);
  nmaj >= 26 ? ok(`node ${process.versions.node}`) : bad(`node ${process.versions.node}`, 'need >= 26');
  onPath('jq') ? ok('jq') : bad('jq', 'required by pl.sh');
  onPath('curl') ? ok('curl') : bad('curl');
  onPath('claude') ? ok('claude CLI') : warn('claude CLI not on PATH', 'needed for the agent sweep');
  if (platform === 'darwin') (onPath('gtimeout') ? ok('gtimeout (coreutils)') : warn('gtimeout missing', 'sweep runs unbounded — brew install coreutils'));
  onPath('tailscale') ? ok('tailscale') : warn('tailscale not found', 'optional — for tailnet access');

  console.log('\nConfig:');
  const envFile = join(dataDir, '.env');
  if (existsSync(envFile)) {
    const mode = statSync(envFile).mode & 0o777;
    mode === 0o600 ? ok('data/.env present', 'mode 600') : warn('data/.env present', `mode ${mode.toString(8)} — should be 600`);
  } else bad('data/.env missing', 'run: punchlist gen-token <actor>');

  console.log('\nService:');
  const spec = serviceSpec(platform, { repo: ROOT, dataDir, node: process.execPath, home });
  existsSync(spec.path) ? ok(`${spec.kind} unit installed`, spec.path) : warn(`${spec.kind} unit not installed`, 'run: punchlist install-service');
  if (spec.kind === 'systemd') {
    const r = spawnSync('systemctl', ['--user', 'is-active', 'punchlist.service'], { encoding: 'utf8' });
    (r.stdout || '').trim() === 'active' ? ok('service active') : warn('service not active', (r.stdout || '').trim() || 'not started');
  } else if (spec.kind === 'launchd') {
    spawnSync('launchctl', ['list', spec.label], { stdio: 'ignore' }).status === 0 ? ok('LaunchAgent loaded') : warn('LaunchAgent not loaded');
  }

  console.log('\nSilverBullet KB (optional):');
  onPath('curl') ? ok('curl (provisioning)') : warn('curl missing', 'needed to provision the SB binary');
  onPath('unzip') ? ok('unzip (provisioning)') : warn('unzip missing', 'needed to provision the SB binary');
  const sbPinnedPath = silverbulletBinPath(home, SILVERBULLET_VERSION);
  if (process.env.SILVERBULLET_CMD) ok('SB binary (SILVERBULLET_CMD)', process.env.SILVERBULLET_CMD);
  else if (existsSync(sbPinnedPath)) ok(`SB binary pinned ${SILVERBULLET_VERSION}`, sbPinnedPath);
  else warn('SB binary not installed', 'run: punchlist install-silverbullet');
  const sbSpec = silverbulletSpec(platform, { repo: ROOT, spaceDir: join(dataDir, 'kb'), home });
  existsSync(sbSpec.path)
    ? ok(`${sbSpec.kind} unit installed`, sbSpec.path)
    : warn(`${sbSpec.kind} unit not installed`, 'optional — run: punchlist install-silverbullet');
  warn('tailnet exposure', 'optional — run: punchlist expose-kb (wires `tailscale serve`)');

  console.log('\nHealth:');
  try {
    const r = await fetch(`http://127.0.0.1:${port}/api/v1/health`);
    if (r.ok) { const h = await r.json().catch(() => ({})); ok(`server up on :${port}`, `build ${h.build ?? '?'}`); }
    else bad(`server responded HTTP ${r.status}`);
  } catch { bad(`server not reachable on :${port}`, 'is the service running?'); }

  console.log('\nAgent sweep:');
  const cron = spawnSync('crontab', ['-l'], { encoding: 'utf8' }).stdout || '';
  const sweepCron = /claude-queue-sweep\.sh/.test(cron);
  const sweepLaunchd = platform === 'darwin' && spawnSync('launchctl', ['list', 'com.punchlist.sweep'], { stdio: 'ignore' }).status === 0;
  (sweepCron || sweepLaunchd) ? ok('sweep scheduled', sweepCron ? 'crontab' : 'launchd') : warn('sweep not scheduled', 'add the cron (directives.json) or a launchd timer');

  console.log('');
  if (hardFail) { console.error('doctor: one or more REQUIRED checks failed'); process.exitCode = 1; }
  else console.log('doctor: OK');
}

// ---- backup: honor the instance's backup_mode/backup_repo (data governance) ----
// snapshot = the WAL-safe db-snapshot (+ restic cron). repo = a SCRUBBED copy —
// the snapshot db + the private artifact dirs (data/{skills,templates,kb,govern})
// — committed & pushed to a private, safe-to-push repo. NEVER copies data/.env,
// media, or the backup staging dir, so secrets never reach the pushable repo.
function readBackupSettings(dbFile) {
  const d = new DatabaseSync(dbFile, { readOnly: true });
  const get = k => d.prepare('SELECT value FROM settings WHERE key = ?').get(k)?.value ?? '';
  const s = { mode: get('backup_mode') || 'snapshot', repo: get('backup_repo') };
  d.close();
  return s;
}
function sh(cmd, args, cwd) {
  const r = spawnSync(cmd, args, { cwd, stdio: 'inherit' });
  if (r.status !== 0) throw new Error(`${cmd} ${args.join(' ')} exited ${r.status}`);
}
function backup(argv) {
  const dry = argv.includes('--dry-run');
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const dbFile = join(dataDir, 'punchlist.db');
  if (!existsSync(dbFile)) { console.error(`punchlist: no database at ${dbFile}`); process.exit(1); }
  const { mode, repo } = readBackupSettings(dbFile);
  console.log(`backup: mode=${mode}${repo ? ` repo=${repo}` : ''}${dry ? ' (dry-run)' : ''}`);
  const wantSnap = mode === 'snapshot' || mode === 'both';
  const wantRepo = mode === 'repo' || mode === 'both';
  const snapSh = join(ROOT, 'scripts', 'db-snapshot.sh');
  const env = { ...process.env, PUNCHLIST_DATA: dataDir };

  if (wantSnap) {
    console.log('backup: snapshot → data/backup (restic cron backs this up)');
    if (!dry) spawnSync('bash', [snapSh], { stdio: 'inherit', env });
  }
  if (wantRepo) {
    if (!repo) { console.error('backup: mode includes "repo" but backup_repo is unset (set it in the Instance dialog)'); process.exit(1); }
    if (!existsSync(repo)) { console.error(`backup: backup_repo does not exist: ${repo}`); process.exit(1); }
    console.log(`backup: repo → ${repo} (scrubbed: snapshot db + data/{skills,templates,kb,govern}; NO .env/media)`);
    if (dry) return;
    spawnSync('bash', [snapSh], { stdio: 'inherit', env }); // fresh WAL-safe snapshot
    copyFileSync(join(dataDir, 'backup', 'punchlist-snapshot.db'), join(repo, 'punchlist-snapshot.db'));
    for (const d of ['skills', 'templates', 'kb', 'govern']) {
      const src = join(dataDir, d);
      if (existsSync(src)) cpSync(src, join(repo, d), { recursive: true });
    }
    const status = spawnSync('git', ['status', '--porcelain'], { cwd: repo, encoding: 'utf8' }).stdout || '';
    if (!status.trim()) { console.log('backup: repo already up to date — nothing to commit'); return; }
    sh('git', ['add', '-A'], repo);
    sh('git', ['commit', '-m', `punchlist backup ${new Date().toISOString()}`], repo);
    sh('git', ['push'], repo);
    console.log('backup: committed + pushed to the private backup repo');
  }
}

const [cmd, ...rest] = process.argv.slice(2);

switch (cmd) {
  case 'serve':
    run(process.execPath, [join(ROOT, 'src', 'server.js')]);
    break;

  case 'mcp':
    run(process.execPath, [join(ROOT, 'src', 'mcp.js')]);
    break;

  case 'install':
    installMcp(rest);
    break;

  case 'install-service':
    await installService(rest);
    break;

  case 'install-silverbullet':
    await installSilverbullet(rest);
    break;

  case 'expose-kb':
    expose(rest);
    break;

  case 'gen-token':
    genToken(rest);
    break;

  case 'doctor':
    await doctor();
    break;

  case 'backup':
    backup(rest);
    break;

  case 'snapshot':
    run('bash', [join(ROOT, 'scripts', 'db-snapshot.sh')]);
    break;

  case 'install-skills': {
    const flags = parseFlags(rest, ['claude', 'hermes']);
    const claudeDir = resolve(flags.claude ?? join(homedir(), '.claude'));
    installSkill(join(ROOT, 'skills', 'claude', 'punchlist'), join(claudeDir, 'skills', 'punchlist'),
      '$HOME/.claude/secrets.local.env');
    // data-governance skill + the guard scripts the PreToolUse hook references
    installSkill(join(ROOT, 'skills', 'claude', 'punchlist-govern'), join(claudeDir, 'skills', 'punchlist-govern'),
      '$HOME/.claude/secrets.local.env');
    const hookDir = join(claudeDir, 'hooks', 'punchlist-govern');
    mkdirSync(hookDir, { recursive: true });
    for (const g of ['govern.sh', 'govern-hook.sh']) {
      const dst = join(hookDir, g);
      copyFileSync(join(ROOT, 'skills', 'shared', g), dst);
      chmodSync(dst, 0o755);
    }
    console.log(`installed govern hook scripts → ${hookDir}`);
    console.log('  wire the guard (warn-only) in settings.json PreToolUse on Write|Edit|MultiEdit:');
    console.log('    if [ -f "$HOME/.claude/hooks/punchlist-govern/govern-hook.sh" ]; then bash "$HOME/.claude/hooks/punchlist-govern/govern-hook.sh" --warn; fi');
    const hermesHome = flags.hermes ?? process.env.HERMES_HOME;
    if (hermesHome) {
      installSkill(join(ROOT, 'skills', 'hermes', 'punchlist'),
        join(resolve(hermesHome), 'skills', 'common', 'punchlist'),
        '${HERMES_HOME:-$HOME/.hermes}/.env');
    } else {
      console.log('hermes skill skipped (no --hermes DIR and HERMES_HOME is not set)');
    }
    console.log(`
Now give each agent its token (this tool never edits your env files):
  - Claude Code: add to ~/.claude/secrets.local.env (chmod 600):
      PUNCHLIST_TOKEN=<that agent's token from data/.env PUNCHLIST_TOKENS>
  - Hermes: add PUNCHLIST_TOKEN=<its token> to $HERMES_HOME/.env
  - Non-default server? Also export PUNCHLIST_URL (default http://127.0.0.1:8600)`);
    break;
  }

  default:
    console.error('usage: punchlist serve | mcp | install -t claude|hermes|all [--print-config] | ' +
      'install-service [--print] [--no-start] | ' +
      'install-silverbullet [--print] [--no-start] [--version TAG] [--skip-binary] | ' +
      'expose-kb [--off] [--status] [--print] | ' +
      'gen-token <actor> | doctor | backup [--dry-run] | ' +
      'install-skills [--claude DIR] [--hermes DIR] | snapshot');
    process.exit(cmd ? 2 : 0);
}
