#!/usr/bin/env node
// punchlist — thin CLI over the repo. Plain node, no dependencies.
//   punchlist serve                                start the server (node src/server.js)
//   punchlist mcp                                  run the MCP stdio server (src/mcp.js)
//   punchlist install -t claude|hermes|all [--print-config]
//                                                  register the MCP server with an agent
//   punchlist install-service [--print] [--no-start]
//                                                  install the always-on service:
//                                                  systemd (Linux) or launchd (macOS)
//   punchlist gen-token <actor>                    print a ready-to-paste token pair
//   punchlist install-skills [--claude DIR] [--hermes DIR]
//                                                  copy the agent skills into place
//   punchlist snapshot                             WAL-safe db backup (scripts/db-snapshot.sh)
import { spawn, spawnSync } from 'node:child_process';
import { cpSync, copyFileSync, existsSync, mkdirSync, writeFileSync, chmodSync, statSync } from 'node:fs';
import { join, dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { homedir } from 'node:os';
import { randomBytes } from 'node:crypto';
import { serviceSpec } from '../src/service.js';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');

function run(cmd, args) {
  const child = spawn(cmd, args, { stdio: 'inherit' });
  child.on('exit', (code, signal) => process.exit(signal ? 1 : code ?? 1));
  child.on('error', err => { console.error(`punchlist: ${err.message}`); process.exit(1); });
}

function parseFlags(argv, allowed) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const name = argv[i].replace(/^--/, '');
    if (!argv[i].startsWith('--') || !allowed.includes(name) || argv[i + 1] === undefined) {
      console.error(`punchlist: bad flag ${argv[i]} (allowed: ${allowed.map(a => '--' + a).join(', ')})`);
      process.exit(2);
    }
    flags[name] = argv[++i];
  }
  return flags;
}

// Copy one skill dir and make it self-contained: the canonical shared pl.sh
// lands next to the shim as scripts/pl-core.sh, and scripts/pl.sh becomes a
// tiny wrapper that pins the agent's own token file (PUNCHLIST_ENV_FILE) so
// each agent authenticates as ITSELF on multi-agent machines.
function installSkill(srcDir, destDir, envFileExpr) {
  mkdirSync(destDir, { recursive: true });
  cpSync(srcDir, destDir, { recursive: true });
  const core = join(destDir, 'scripts', 'pl-core.sh');
  copyFileSync(join(ROOT, 'skills', 'shared', 'pl.sh'), core);
  chmodSync(core, 0o755);
  const shim = join(destDir, 'scripts', 'pl.sh');
  writeFileSync(shim, '#!/usr/bin/env bash\n' +
    `exec env PUNCHLIST_ENV_FILE="${envFileExpr}" "$(dirname "\${BASH_SOURCE[0]}")/pl-core.sh" "$@"\n`);
  chmodSync(shim, 0o755);
  // the screening library (agent-security layer 2) travels with every skill;
  // it needs no token, so the canonical copy lands as-is (replacing the
  // repo-relative shim from the source dir)
  const screen = join(destDir, 'scripts', 'screen.sh');
  copyFileSync(join(ROOT, 'skills', 'shared', 'screen.sh'), screen);
  chmodSync(screen, 0o755);
  console.log(`installed ${destDir}`);
}

// ---- MCP registration (codegraph-style): register where we safely can,
// print copy-paste config where we must not edit files we don't own. ----
const CLAUDE_SNIPPET = `{
  "mcpServers": {
    "punchlist": {
      "command": "punchlist",
      "args": ["mcp"]
    }
  }
}`;
const HERMES_SNIPPET = `mcp_servers:
  punchlist:
    command: punchlist
    args: [mcp]`;
const ENV_NOTE = `
The MCP server authenticates like the skills do: PUNCHLIST_TOKEN in the agent's
environment, or PUNCHLIST_ENV_FILE, or ~/.claude/secrets.local.env, or
$HERMES_HOME/.env. Non-default server? Also set PUNCHLIST_URL (default
http://127.0.0.1:8600). \`punchlist\` must be on PATH (npm link / npm i -g).`;

function installClaude({ printOnly }) {
  if (!printOnly && spawnSync('claude', ['--version'], { stdio: 'ignore' }).status === 0) {
    const r = spawnSync('claude', ['mcp', 'add', 'punchlist', '--scope', 'user', '--', 'punchlist', 'mcp'],
      { stdio: 'inherit' });
    if (r.status === 0) { console.log('registered with Claude Code (user scope)'); return; }
    console.error('claude mcp add failed — falling back to the config snippet:');
  } else if (!printOnly) {
    console.log('claude CLI not found — add this to your project .mcp.json (or Claude Desktop config):');
  } else {
    console.log('Claude Code: `claude mcp add punchlist --scope user -- punchlist mcp`, or .mcp.json:');
  }
  console.log(CLAUDE_SNIPPET);
}

function installHermes() {
  console.log('Hermes: add to the mcp_servers block of $HERMES_HOME/config.yaml (not edited automatically):');
  console.log(HERMES_SNIPPET);
}

function installMcp(argv) {
  let target = null, printOnly = false;
  for (let i = 0; i < argv.length; i++) {
    if ((argv[i] === '-t' || argv[i] === '--target') && argv[i + 1]) target = argv[++i];
    else if (argv[i] === '--print-config') printOnly = true;
    else { console.error(`punchlist: bad flag ${argv[i]}`); process.exit(2); }
  }
  if (printOnly && !target) target = 'all';
  if (!['claude', 'hermes', 'all'].includes(target)) {
    console.error('usage: punchlist install -t claude|hermes|all [--print-config]');
    process.exit(2);
  }
  if (target === 'claude' || target === 'all') installClaude({ printOnly });
  if (target === 'all') console.log('');
  if (target === 'hermes' || target === 'all') installHermes();
  console.log(ENV_NOTE);
}

// ---- service install (systemd on Linux, launchd on macOS) ----
// One command, both OSes: `punchlist install-service`. Platform-specific unit
// rendering lives in src/service.js; this does the file write + service load.
async function healthCheck(port, tries = 20) {
  for (let i = 0; i < tries; i++) {
    try { if ((await fetch(`http://127.0.0.1:${port}/api/v1/health`)).ok) return true; } catch { /* not up yet */ }
    await new Promise(r => setTimeout(r, 600));
  }
  return false;
}

async function installService(argv) {
  let printOnly = false, noStart = false, platform = process.platform;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--print') printOnly = true;
    else if (argv[i] === '--no-start') noStart = true;
    else if (argv[i] === '--platform' && argv[i + 1]) platform = argv[++i]; // for --print / testing
    else { console.error(`punchlist: bad flag ${argv[i]} (allowed: --print, --no-start, --platform)`); process.exit(2); }
  }
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const spec = serviceSpec(platform, { repo: ROOT, dataDir, node: process.execPath, home: homedir() });

  if (printOnly) { console.log(`# ${spec.kind} unit -> ${spec.path}\n`); process.stdout.write(spec.contents); return; }
  if (platform !== process.platform) {
    console.error(`punchlist: refusing to install a ${platform} service on ${process.platform} (drop --platform, or use --print)`);
    process.exit(2);
  }
  const envFile = join(dataDir, '.env');
  if (!existsSync(envFile)) {
    console.error(`punchlist: missing ${envFile} (it holds PUNCHLIST_TOKENS). Generate a token first:\n` +
      `  punchlist gen-token <actor>   # e.g. aron\n` +
      `then create ${envFile} (chmod 600) with the PUNCHLIST_TOKENS line it prints.`);
    process.exit(1);
  }

  mkdirSync(dirname(spec.path), { recursive: true });
  writeFileSync(spec.path, spec.contents);
  if (spec.mode) chmodSync(spec.path, spec.mode);
  console.log(`wrote ${spec.kind} unit -> ${spec.path}`);
  if (noStart) { console.log(`(--no-start) not loading it. Start later with: ${spec.start[0][0]} ${spec.start[0][1].join(' ')}`); return; }

  // reload/unload is best-effort (fails harmlessly on a first install)
  for (const [c, a] of spec.reload) spawnSync(c, a, { stdio: 'ignore' });
  for (const [c, a] of spec.start) spawnSync(c, a, { stdio: 'inherit' });

  if (await healthCheck(spec.port)) {
    console.log(`punchlist: healthy on http://127.0.0.1:${spec.port} — service is running`);
  } else {
    console.error(`punchlist: unit written but health check failed. Inspect: ${spec.status[0]} ${spec.status[1].join(' ')}`);
    process.exitCode = 1;
  }
}

// ---- token generation: print a ready-to-paste PUNCHLIST_TOKENS pair ----
// Never writes your env files (same policy as install-skills); prints only.
function genToken(argv) {
  const actor = argv[0];
  if (!actor || actor.startsWith('-')) {
    console.error('usage: punchlist gen-token <actor>   # e.g. aron, claude, hermes');
    process.exit(2);
  }
  const token = randomBytes(24).toString('hex'); // 48 hex chars (server floor is 32)
  console.log(`# Server side — add "${actor}" to PUNCHLIST_TOKENS in your data/.env (chmod 600).`);
  console.log(`# The FIRST actor is the admin unless PUNCHLIST_ADMIN is set.`);
  console.log(`PUNCHLIST_TOKENS=${actor}:${token}`);
  console.log(`# Client side — give that actor its token (e.g. ~/.claude/secrets.local.env, chmod 600):`);
  console.log(`PUNCHLIST_TOKEN=${token}`);
}

// ---- doctor: prerequisites + config + service + health, one checklist ----
// Cross-platform: uses the same serviceSpec() to know where the unit lives, and
// /health for liveness. Never reads token *values* — only stats data/.env.
async function doctor() {
  const platform = process.platform;
  const home = homedir();
  const dataDir = process.env.PUNCHLIST_DATA || join(ROOT, 'data');
  const port = 8600;
  let hardFail = false;
  const ok = (l, x = '') => console.log(`  ✓ ${l}${x ? `  — ${x}` : ''}`);
  const bad = (l, x = '') => { console.log(`  ✗ ${l}${x ? `  — ${x}` : ''}`); hardFail = true; };
  const warn = (l, x = '') => console.log(`  ⚠ ${l}${x ? `  — ${x}` : ''}`);
  const onPath = c => spawnSync('sh', ['-c', `command -v ${c}`], { stdio: 'ignore' }).status === 0;

  console.log('punchlist doctor\n\nPrerequisites:');
  const nmaj = Number(process.versions.node.split('.')[0]);
  nmaj >= 26 ? ok(`node ${process.versions.node}`) : bad(`node ${process.versions.node}`, 'need >= 26');
  onPath('jq') ? ok('jq') : bad('jq', 'required by pl.sh');
  onPath('curl') ? ok('curl') : bad('curl');
  onPath('claude') ? ok('claude CLI') : warn('claude CLI not on PATH', 'needed for the agent sweep');
  if (platform === 'darwin') (onPath('gtimeout') ? ok('gtimeout (coreutils)') : warn('gtimeout missing', 'sweep runs unbounded — brew install coreutils'));
  onPath('tailscale') ? ok('tailscale') : warn('tailscale not found', 'optional — for tailnet access');

  console.log('\nConfig:');
  const envFile = join(dataDir, '.env');
  if (existsSync(envFile)) {
    const mode = statSync(envFile).mode & 0o777;
    mode === 0o600 ? ok('data/.env present', 'mode 600') : warn('data/.env present', `mode ${mode.toString(8)} — should be 600`);
  } else bad('data/.env missing', 'run: punchlist gen-token <actor>');

  console.log('\nService:');
  const spec = serviceSpec(platform, { repo: ROOT, dataDir, node: process.execPath, home });
  existsSync(spec.path) ? ok(`${spec.kind} unit installed`, spec.path) : warn(`${spec.kind} unit not installed`, 'run: punchlist install-service');
  if (spec.kind === 'systemd') {
    const r = spawnSync('systemctl', ['--user', 'is-active', 'punchlist.service'], { encoding: 'utf8' });
    (r.stdout || '').trim() === 'active' ? ok('service active') : warn('service not active', (r.stdout || '').trim() || 'not started');
  } else if (spec.kind === 'launchd') {
    spawnSync('launchctl', ['list', spec.label], { stdio: 'ignore' }).status === 0 ? ok('LaunchAgent loaded') : warn('LaunchAgent not loaded');
  }

  console.log('\nHealth:');
  try {
    const r = await fetch(`http://127.0.0.1:${port}/api/v1/health`);
    if (r.ok) { const h = await r.json().catch(() => ({})); ok(`server up on :${port}`, `build ${h.build ?? '?'}`); }
    else bad(`server responded HTTP ${r.status}`);
  } catch { bad(`server not reachable on :${port}`, 'is the service running?'); }

  console.log('\nAgent sweep:');
  const cron = spawnSync('crontab', ['-l'], { encoding: 'utf8' }).stdout || '';
  const sweepCron = /claude-queue-sweep\.sh/.test(cron);
  const sweepLaunchd = platform === 'darwin' && spawnSync('launchctl', ['list', 'com.punchlist.sweep'], { stdio: 'ignore' }).status === 0;
  (sweepCron || sweepLaunchd) ? ok('sweep scheduled', sweepCron ? 'crontab' : 'launchd') : warn('sweep not scheduled', 'add the cron (directives.json) or a launchd timer');

  console.log('');
  if (hardFail) { console.error('doctor: one or more REQUIRED checks failed'); process.exitCode = 1; }
  else console.log('doctor: OK');
}

const [cmd, ...rest] = process.argv.slice(2);

switch (cmd) {
  case 'serve':
    run(process.execPath, [join(ROOT, 'src', 'server.js')]);
    break;

  case 'mcp':
    run(process.execPath, [join(ROOT, 'src', 'mcp.js')]);
    break;

  case 'install':
    installMcp(rest);
    break;

  case 'install-service':
    await installService(rest);
    break;

  case 'gen-token':
    genToken(rest);
    break;

  case 'doctor':
    await doctor();
    break;

  case 'snapshot':
    run('bash', [join(ROOT, 'scripts', 'db-snapshot.sh')]);
    break;

  case 'install-skills': {
    const flags = parseFlags(rest, ['claude', 'hermes']);
    const claudeDir = resolve(flags.claude ?? join(homedir(), '.claude'));
    installSkill(join(ROOT, 'skills', 'claude', 'punchlist'), join(claudeDir, 'skills', 'punchlist'),
      '$HOME/.claude/secrets.local.env');
    const hermesHome = flags.hermes ?? process.env.HERMES_HOME;
    if (hermesHome) {
      installSkill(join(ROOT, 'skills', 'hermes', 'punchlist'),
        join(resolve(hermesHome), 'skills', 'common', 'punchlist'),
        '${HERMES_HOME:-$HOME/.hermes}/.env');
    } else {
      console.log('hermes skill skipped (no --hermes DIR and HERMES_HOME is not set)');
    }
    console.log(`
Now give each agent its token (this tool never edits your env files):
  - Claude Code: add to ~/.claude/secrets.local.env (chmod 600):
      PUNCHLIST_TOKEN=<that agent's token from data/.env PUNCHLIST_TOKENS>
  - Hermes: add PUNCHLIST_TOKEN=<its token> to $HERMES_HOME/.env
  - Non-default server? Also export PUNCHLIST_URL (default http://127.0.0.1:8600)`);
    break;
  }

  default:
    console.error('usage: punchlist serve | mcp | install -t claude|hermes|all [--print-config] | ' +
      'install-service [--print] [--no-start] | gen-token <actor> | doctor | ' +
      'install-skills [--claude DIR] [--hermes DIR] | snapshot');
    process.exit(cmd ? 2 : 0);
}
