                                             gate re-approvals and writing-adversary fail rate -> process/suggestions.md

  plt fan <plan-file> [--ledger <path>] [--json]
                                             print the next parallel wave of a plan's tasks (read-only)
  plt fsck [<run>] [--all] [--fix] [--project <dir>] [--json]
                                             check a run's state + events against the formula; --fix writes
  plt schema list | plt schema validate <kind> <file>
                                             validate a state/events/input/effort/config file against its schema
  plt harvest <id> [--dry-run] [--json]     turn a suggestions.md row into a branch + diff for a human to merge
  plt bump --target <t> --expected <text> --measure-at <date> [--id <id>]
                                             append the change to the CHANGELOG and bump the target's version

Repo root: $PUNCHLIST_TEMPLATES_DIR, else the checkout containing this script.
Punchlist auth: $PUNCHLIST_URL + $PUNCHLIST_TOKEN (or the pl.sh env files).
Workflows with \`owner\` steps additionally require $PUNCHLIST_OWNER.
`;

// The verbs bin/plt still implements itself. Every other verb lives in the module that owns
// it — lib/registry.js scans lib/*.js for a `commands` export and dispatches on argv[0], so
// adding a subcommand never edits this file again.
const commands = [
  { name: 'index', usage: 'plt index', handler: (argv) => cmdIndex(argv) },
  { name: 'list', usage: 'plt list [--kind K] [--tag T] [--domain D]', handler: (argv) => cmdList(argv) },
  { name: 'show', usage: 'plt show <name>', handler: (argv) => cmdShow(argv) },
  { name: 'render', usage: 'plt render <workflow> | plt render --workflow <name> | plt render index|run <id>|all [--out <dir>]', handler: (argv) => cmdRender(argv) },
  { name: 'launch', usage: 'plt launch <workflow> --input k=v ...', handler: (argv) => cmdLaunch(argv) },
  { name: 'advance', usage: 'plt advance [--run ID | --all]', handler: (argv) => cmdAdvance(argv) },
  { name: 'runs', usage: 'plt runs', handler: (argv) => cmdRuns(argv) },
  { name: 'lint', usage: 'plt lint prose <file|-> [--json]', handler: (argv) => require('../lib/lint').cli(argv) },
  { name: 'integration', usage: 'plt integration install|status <name> [--project <dir>] [--load]', handler: (argv) => require('../lib/integration').cli(argv) },
];

// The shim. It parses nothing and names no verb: `plt help` prints the long usage, everything
// else goes to the registry, which returns the exit code (or a promise of one).
async function main(argv) {
  const cmd = argv[0];
  // `plt help` asks for the usage, so it goes to stdout and exits 0. A bare `plt` is a
  // mis-invocation: the usage goes to stderr and the exit code stays 2, as it always has.
  if (cmd === 'help' || cmd === '-h' || cmd === '--help') { process.stdout.write(USAGE); return 0; }
  // `plt --version` prints package.json's version — the shipped version doctor's `plt-resolvable`
  // check (lib/doctor.js) compares `plt` on PATH against, and what `plt integration status`/CI
  // read to prove the checkout in use. No task before this one added it.
  if (cmd === '--version' || cmd === '-v') { process.stdout.write(require('../package.json').version + '\n'); return 0; }
  if (!cmd) { process.stderr.write(USAGE); return 2; }
  return require('../lib/registry').dispatch(argv, {
    libDir: path.join(__dirname, '..', 'lib'),
    cwd: process.cwd(),
    env: process.env,
    commands,
  });
}

// Exports are assigned BEFORE the require.main check runs `main()`: a `plt run|step|...`
// subcommand requires lib/spine-cli -> lib/spine -> this file (for parseWorkflow), and that
// circular require must see a fully-populated module.exports, not the empty default.
module.exports = {
  ROOT,
  parseFrontmatter,
  parseScalar,
  parseSteps,
  parseWorkflow,
  findSection,
  validateFile,
  validateWorkflow,
  findDependencyCycle,
  collectFiles,
  walk,
  templateNames,
  buildIndex,
  writeIndex,
  indexPath,
  renderMermaid,
  injectMermaid,
  interpolate,
  buildTrailer,
  taskBodyForStep,
  initialSteps,
  decide,
  main,
  commands,
  MIN_EXEMPLAR_CHARS,
  MERMAID_OPEN,
  MERMAID_CLOSE,
};

// process.exitCode, never process.exit(): on macOS a pipe on stdout is asynchronous, and an exit
// before it drains cuts piped output at the pipe buffer (a truncated `--json`).
if (require.main === module) {
  main(process.argv.slice(2)).then(
    (code) => { process.exitCode = code; },
    (err) => { process.stderr.write(`plt: ${err.message}\n`); process.exitCode = 1; }
  );
}
