const HELP_USAGE_INDENT = '  ';    // a declared usage alternative starts here
const HELP_WRAP_INDENT = '     ';  // its continuation, deeper than the usage and shallower than prose
const HELP_PROSE_INDENT = '      ';
const HELP_WIDTH = 96;

// Greedy wrap, so a description is written as one string here and not pre-broken into lines, and
// so a long declaration folds instead of running off the terminal.
function wrapText(text, width, first, cont) {
  const out = [];
  let line = first;
  for (const word of String(text).split(/\s+/).filter(Boolean)) {
    if (line.trim() && line.length + 1 + word.length > width) { out.push(line); line = cont + word; }
    else line = line.trim() ? `${line} ${word}` : line + word;
  }
  if (line.trim()) out.push(line);
  return out;
}

// A declaration separates whole alternatives with ` | ` before another `plt `; a bare `|` inside
// one alternative (`[--run ID | --all]`, `check|approve|revoke`) is part of that line.
function usageAlternatives(usage) {
  return String(usage).split(/ \| (?=plt )/).map((u) => u.trim());
}

// One command's block: every alternative of its DECLARED usage, then its prose.
function helpEntry(usage, prose) {
  const out = [];
  for (const alt of usageAlternatives(usage)) {
    out.push(...wrapText(alt, HELP_WIDTH, HELP_USAGE_INDENT, HELP_WRAP_INDENT));
  }
  const text = typeof prose === 'function' ? prose() : prose;
  if (text) out.push(...wrapText(text, HELP_WIDTH, HELP_PROSE_INDENT, HELP_PROSE_INDENT));
  return out.join('\n');
}

// The --take-over note. Which verbs take the flag is NOT written here: it is read off the
// declarations, so a verb that gains or loses --take-over changes this paragraph by itself.
function takeOverNote(declared) {
  const verbs = [...declared.keys()].filter((n) => String(declared.get(n).usage || '').includes('--take-over'));
  if (verbs.length === 0) return '';
  return '\n' + wrapText(
    '--take-over drives a run another window (state.owner_window) has not handed off; it is logged as a '
      + 'taken-over event. Taken by: ' + verbs.sort().map((v) => `\`plt ${v}\``).join(', ') + '.',
    HELP_WIDTH, HELP_USAGE_INDENT, HELP_USAGE_INDENT).join('\n') + '\n';
}

// helpText(declared) -> the text `plt help` prints. Pure: everything it says comes from the
// descriptor map it is handed, plus the prose above. `declared` is Map<name, {usage}>; a
// descriptor with no usage falls back to the bare verb, as lib/registry does.
function helpText(declared) {
  const rest = [...declared.keys()].filter((n) => !HELP_ORDER.includes(n)).sort();
  const names = [...HELP_ORDER.filter((n) => declared.has(n)), ...rest];
  const usageOf = (n) => declared.get(n).usage || `plt ${n}`;
  const body = names.map((n) => helpEntry(usageOf(n), HELP_PROSE[n])).join('\n');
  return HELP_HEAD + body + '\n' + takeOverNote(declared) + HELP_EPILOGUE;
}

// buildUsage() -> the help for THIS checkout. Built on demand, never at load: a lib module may
// require this file back (lib/spine.js does, for the parser), and discovery requires every one.
// mergeBuiltins(declared, builtins) -> the same map, with this file's own verbs added. It applies
// the rule lib/registry.dispatch applies when it merges the same two sources: a verb claimed twice
// is a bug that stops the CLI. Without it the help would advertise a verb the dispatcher refuses.
function mergeBuiltins(declared, builtins) {
  for (const c of builtins) {
    const seen = declared.get(c.name);
    if (seen) throw new Error(`duplicate command "${c.name}" in ${seen.module} and <builtin>`);
    declared.set(c.name, c);
  }
  return declared;
}

function buildUsage() {
  const libDir = path.join(__dirname, '..', 'lib');
  return helpText(mergeBuiltins(require('../lib/registry').discoverCommands(libDir), commands));
}

// The verbs bin/plt still implements itself. Every other verb lives in the module that owns
// it — lib/registry.js scans lib/*.js for a `commands` export and dispatches on argv[0], so
// adding a subcommand adds no handler here and no usage line here. It still prints in `plt help`
// with no edit at all (after the ordered verbs, usage only); giving it a place in the reading
// order and a description is the one reason left to open this file for a verb it does not own.
const commands = [
  { name: 'index', usage: 'plt index', handler: (argv) => cmdIndex(argv) },
  { name: 'list', usage: 'plt list [--kind K] [--tag T] [--domain D]', handler: (argv) => cmdList(argv) },
  { name: 'show', usage: SHOW_USAGE, handler: (argv) => cmdShow(argv) },
  { name: 'render', usage: RENDER_USAGE, handler: (argv) => cmdRender(argv) },
  { name: 'launch', usage: LAUNCH_USAGE, handler: (argv) => cmdLaunch(argv) },
  { name: 'advance', usage: 'plt advance [--run ID | --all]', handler: (argv) => cmdAdvance(argv) },
  { name: 'runs', usage: 'plt runs', handler: (argv) => cmdRuns(argv) },
  { name: 'lint', usage: 'plt lint prose <file|-> [--json]', handler: (argv) => require('../lib/lint').cli(argv) },
  { name: 'integration', usage: 'plt integration install|status <name> [--project <dir>] [--load]', handler: (argv) => require('../lib/integration').cli(argv) },
];

// The shim. It parses nothing and names no verb: `plt help` prints the long usage, everything
// else goes to the registry, which returns the exit code (or a promise of one).
async function main(argv) {
  const cmd = argv[0];
  // `plt help` asks for the usage, so it goes to stdout and exits 0. A bare `plt` is a
  // mis-invocation: the usage goes to stderr and the exit code stays 2, as it always has.
  if (cmd === 'help' || cmd === '-h' || cmd === '--help') { process.stdout.write(buildUsage()); return 0; }
  // `plt --version` prints package.json's version — the shipped version doctor's `plt-resolvable`
  // check (lib/doctor.js) compares `plt` on PATH against, and what `plt integration status`/CI
  // read to prove the checkout in use. No task before this one added it.
  if (cmd === '--version' || cmd === '-v') { process.stdout.write(require('../package.json').version + '\n'); return 0; }
  if (!cmd) { process.stderr.write(buildUsage()); return 2; }
  return require('../lib/registry').dispatch(argv, {
    libDir: path.join(__dirname, '..', 'lib'),
    cwd: process.cwd(),
    env: process.env,
    commands,
  });
}

// Exports are assigned BEFORE the require.main check runs `main()`: a `plt run|step|...`
// subcommand requires lib/spine-cli -> lib/spine -> this file (for parseWorkflow), and that
// circular require must see a fully-populated module.exports, not the empty default.
module.exports = {
  ROOT,
  parseFrontmatter,
  parseScalar,
  parseSteps,
  parseWorkflow,
  findSection,
  validateFile,
  validateWorkflow,
  findDependencyCycle,
