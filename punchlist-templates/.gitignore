# Whitelist-first: ignore everything at the top level, then re-allow tracked paths.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/README.md
!/LICENSE
!/docs/
!/templates/
!/workflows/
!/skills/
!/bin/
!/scripts/
!/test/
!/lib/
!/schemas/
!/.github/
# process/: config and cycles are AUTHORED and tracked — they are what makes this
# repo a spine project, and a fresh clone must reproduce it. process/runs/ (state),
# process/build/ (rendered pages) and everything else under it stay ignored.
!/process/
/process/*
!/process/config/
!/process/cycles/
!/process/efforts/
# ...but only the authored effort FILES. process/efforts/<slug>/ holds that
# effort's events.jsonl, which is state like process/runs/ and must not be
# committed - a decision ledger in git would conflict on every parallel card.
/process/efforts/*/
# .claude/ is GENERATED by `plt integration install claude --project .` — the hooks
# carry a managed version header and reinstalling overwrites them, so tracking a copy
# would fork it from the package it belongs to. `plt doctor` reports when it is stale.
# runs/ (per-run advancer state), .obsidian/ (vault config), and
# node_modules stay ignored by /*
# .worktrees/ (per-window worktrees, scripts/plt-worktree.sh) stays ignored
# by /* too; the repo-window claim lives in the git dir, not the tree
!/integrations/
__pycache__/
